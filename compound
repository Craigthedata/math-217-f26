    {
      "cell_type": "code",
      "source": [
        "# Create data for different compounding frequencies\n",
        "\n",
        "years = np.linspace(0, 30, 301)\n",
        "\n",
        "data = []\n",
        "\n",
        "for name, n in frequencies.items():\n",
        "    for year in years:\n",
        "        amount = compound_interest(P, r, n, year)\n",
        "\n",
        "        data.append({\n",
        "            \"Year\": year,\n",
        "            \"Investment Value\": amount,\n",
        "            \"Compounding\": name\n",
        "        })\n",
        "\n",
        "df_compounding = pd.DataFrame(data)\n",
        "\n",
        "# Interactive Plotly graph\n",
        "\n",
        "fig = px.line(\n",
