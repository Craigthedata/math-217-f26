        "# 4. Continuous Compounding\n",
        "\n",
        "Now let's compare ordinary compound interest with continuous compounding.\n",
        "\n",
        "The continuous compounding formula is:\n",
        "\n",
        "$\n",
        "A=Pe^{rt}\n",
        "$\n",
        "\n",
        "In Python, we can calculate this using:\n",
        "\n",
        "```python\n",
        "np.exp(r*t)"
      ],
      "metadata": {
        "id": "w6JgeBM9FgoO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "def continuous_compound_interest(P, r, t):\n",
        "    \"\"\"\n",
        "    Calculate future value using continuous compounding.\n",
        "    \"\"\"\n",
        "\n",
        "    return P * np.exp(r*t)\n",
        "\n",
        "\n",
        "# Create comparison data\n",
        "\n",
        "years = np.linspace(0, 30, 301)\n",
        "\n",
        "comparison_data = []\n",
        "\n",
        "for year in years:\n",
        "\n",
        "    monthly = compound_interest(P, r, 12, year)\n",
        "    continuous = continuous_compound_interest(P, r, year)\n",
        "\n",
        "    comparison_data.append({\n",
        "        \"Year\": year,\n",
        "        \"Monthly Compounding\": monthly,\n",
        "        \"Continuous Compounding\": continuous\n",
        "    })\n",
        "\n",
        "df_continuous = pd.DataFrame(comparison_data)\n",
        "\n",
        "# Plot\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(\n",
        "    go.Scatter(\n",
        "        x=df_continuous[\"Year\"],\n",
        "        y=df_continuous[\"Monthly Compounding\"],\n",
        "        mode=\"lines\",\n",
        "        name=\"Monthly Compounding\"\n",
        "    )\n",
        ")\n",
        "\n",
        "fig.add_trace(\n",
        "    go.Scatter(\n",
        "        x=df_continuous[\"Year\"],\n",
        "        y=df_continuous[\"Continuous Compounding\"],\n",
        "        mode=\"lines\",\n",
        "        name=\"Continuous Compounding\"\n",
        "    )\n",
        ")\n",
        "\n",
        "fig.update_layout(\n",
        "    title=\"Monthly vs. Continuous Compounding\",\n",
